# Copy to .env and fill in every REQUIRED value before running ./scripts/bootstrap.sh.
# Use shell-safe values for secrets (letters, digits, hyphens, underscores).
PROJECT_DOMAIN=devops.forageek.com
ACME_EMAIL=required
CF_DNS_API_TOKEN=required

# Home-server dynamic DNS. Create the wildcard A record before starting Compose.
DDNS_PUID=1000
DDNS_PGID=1000
CF_DDNS_API_TOKEN=required
CF_ZONE_ID=required
CF_RECORD_NAME=*.devops.forageek.com
DDNS_SCHEDULE=5m
DISCORD_URI=

# Authentik bootstrap values (only used on its first start)
AUTHENTIK_VERSION=2026.8.0
AUTHENTIK_SECRET_KEY=required
AUTHENTIK_POSTGRES_PASSWORD=required
AUTHENTIK_BOOTSTRAP_EMAIL=required
AUTHENTIK_BOOTSTRAP_PASSWORD=required

# Linkwarden and Meilisearch
LINKWARDEN_VERSION=latest
LINKWARDEN_POSTGRES_PASSWORD=required
LINKWARDEN_NEXTAUTH_SECRET=required
LINKWARDEN_MEILI_MASTER_KEY=required
LINKWARDEN_OIDC_ENABLED=false
LINKWARDEN_OIDC_CLIENT_ID=
LINKWARDEN_OIDC_CLIENT_SECRET=

# WordPress and MariaDB
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=required
WORDPRESS_DB_ROOT_PASSWORD=required

# Backups are local under the project by default, then copied to the rclone crypt remote.
# To use a separate mounted disk, set BACKUP_ROOT inside it and set BACKUP_MOUNT to its mountpoint.
BACKUP_ROOT=./backups
BACKUP_MOUNT=
RCLONE_CONFIG=/etc/rclone/rclone.conf
RCLONE_REMOTE=encrypted-remote:devops-stack
BACKUP_DAILY_KEEP=30
BACKUP_MONTHLY_KEEP=12

# Image tags are deliberately centralized for controlled upgrades.
TRAEFIK_VERSION=v3.7
POSTGRES_VERSION=16-alpine
MARIADB_VERSION=11.4
WORDPRESS_VERSION=7-php8.3-apache
UPTIME_KUMA_VERSION=2
EXCALIDRAW_VERSION=latest
